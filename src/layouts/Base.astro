---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;
const fullTitle = title === 'Portfolio' ? title : `${title} · Portfolio`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex, nofollow" />
		<title>{fullTitle}</title>
		{description && <meta name="description" content={description} />}
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-header">
			<div class="inner">
				<p class="site-title"><a href="/">Portfolio</a></p>
			</div>
		</header>
		<main id="main" class="site-main">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="inner">
				<p class="muted">Static portfolio — not intended for search indexing.</p>
			</div>
		</footer>
	</body>
</html>

<style>
	.skip-link {
		position: absolute;
		left: -9999px;
		z-index: 999;
		padding: 0.5rem 1rem;
		background: #fff;
		border: 1px solid #ccc;
	}
	.skip-link:focus {
		left: 1rem;
		top: 1rem;
	}
	.site-header {
		border-bottom: 1px solid #e0e0e0;
		background: #fff;
	}
	.site-header .inner,
	.site-footer .inner,
	.site-main {
		max-width: 42rem;
		margin: 0 auto;
		padding: 1rem 1.25rem;
	}
	.site-title {
		margin: 0;
		font-size: 1.125rem;
		font-weight: 600;
	}
	.site-title a {
		color: inherit;
		text-decoration: none;
	}
	.site-title a:hover {
		text-decoration: underline;
	}
	.site-footer {
		margin-top: 2rem;
		border-top: 1px solid #e0e0e0;
		background: #fff;
		font-size: 0.875rem;
	}
	.muted {
		color: #555;
		margin: 0;
	}
	@media (min-width: 48rem) {
		.site-header .inner,
		.site-footer .inner,
		.site-main {
			padding-left: 2rem;
			padding-right: 2rem;
		}
	}
</style>
