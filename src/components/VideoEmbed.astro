---
import { parseVideoEmbedUrl } from '../lib/video';

interface Props {
	url: string;
	title: string;
}

const { url, title } = Astro.props;
const parsed = parseVideoEmbedUrl(url);
---

{
	parsed.embedUrl ? (
		<div class="video-frame">
			<iframe
				src={parsed.embedUrl}
				title={title}
				loading="lazy"
				referrerpolicy="strict-origin-when-cross-origin"
				allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
				allowfullscreen
			/>
		</div>
	) : (
		<p class="video-fallback">
			<a href={url}>Watch video</a>
			<span class="hint"> (URL not recognized as YouTube or Vimeo embed — open the link.)</span>
		</p>
	)
}

<style>
	.video-frame {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		background: #e8e8e8;
		border-radius: 8px;
		overflow: hidden;
		margin: 1rem 0;
	}
	.video-frame iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
	.video-fallback {
		margin: 1rem 0;
	}
	.hint {
		color: #555;
		font-size: 0.9rem;
	}
</style>
